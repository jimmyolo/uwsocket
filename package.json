{
  "name": "@jimmyolo/u-wsocket",
  "version": "2.3.3",
  "description": "☄️ WebSocket server, based on μWebSockets.js",
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "files": [
    "dist",
    "src/index.d.ts"
  ],
  "main": "dist/index.js",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "npx husky",
    "ai:init": "codegraph init -i",
    "ai:status": "codegraph status",
    "ai:sync": "codegraph sync",
    "ai:reindex": "codegraph index --force",
    "test": "PORT=8888 node tests",
    "test:types": "tsd --typings src/index.d.ts",
    "build": "node build.js",
    "clean": "rm -rf build dist",
    "release": "npx release-it --verbose",
    "release:dry": "aube run release -- --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyolo/u-wsocket.git"
  },
  "optionalDependencies": {
    "bufferutil": "4.1.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.68.0",
    "ultimate-ws": "2.0.9"
  },
  "dependencies": {
    "tseep": "1.3.1",
    "ws": "8.21.0",
    "@jimmyolo/uws.js": "github:jimmyolo/uws.js#v20.68.0-alma.1"
  },
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "baseUrl": ".",
      "paths": {
        "@jimmyolo/u-wsocket": [
          "./src/index.d.ts"
        ]
      }
    }
  }
}