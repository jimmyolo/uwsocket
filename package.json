{
  "name": "@jimmyolo/u-wsocket",
  "version": "2.8.1",
  "description": "☄️ WebSocket server, based on μWebSockets.js",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src/index.d.ts",
    "src/sse/index.d.ts"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./sse": {
      "import": {
        "types": "./dist/sse.d.ts",
        "default": "./dist/sse.mjs"
      },
      "require": {
        "types": "./dist/sse.d.ts",
        "default": "./dist/sse.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyolo/u-wsocket.git"
  },
  "license": "Apache-2.0",
  "optionalDependencies": {
    "bufferutil": "4.2.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.71.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "better-sse": "0.16.1",
    "ws": "~8.23.0",
    "@jimmyolo/uws.js": "github:jimmyolo/uws.js#v20.71.0-alma.1"
  },
  "lint-staged": {
    "src/**/*.{js,mjs,ts}": "aubx @biomejs/biome check --write --no-errors-on-unmatched"
  },
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "paths": {
        "@jimmyolo/u-wsocket": [
          "./src/index.d.ts"
        ],
        "@jimmyolo/u-wsocket/sse": [
          "./src/sse/index.d.ts"
        ]
      }
    }
  }
}